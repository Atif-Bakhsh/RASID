# Browser-visible base URL for the existing NestJS API.
# For local development, point directly to the local backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Optional server-side proxy target for a Vercel deployment without a custom
# domain. Set the browser-visible base to https://<vercel-project>.vercel.app/api/v1
# and set this to the Railway API origin (no /api/v1 path). This value is not
# exposed to browser JavaScript.
# RASID_API_PROXY_ORIGIN=https://rasid-api-production.example.up.railway.app

# Optional pair for an intentionally public synthetic demo account. Omit both to
# hide the credential helper. These values are browser-visible and are not secrets.
NEXT_PUBLIC_DEMO_EMAIL=atif@example.test
NEXT_PUBLIC_DEMO_PASSWORD=Synthetic-Demo-Only-2026!
