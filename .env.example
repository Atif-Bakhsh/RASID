# Synthetic demo only. Copy to .env for local use. Replace secrets before deployment.
NODE_ENV=development
PORT=3000
POSTGRES_PORT=55432
POSTGRES_DB=rasid
POSTGRES_USER=rasid
POSTGRES_PASSWORD=rasid-local-demo-only
DATABASE_URL=postgresql://rasid:rasid-local-demo-only@localhost:55432/rasid
DATABASE_SSL=false
JWT_SECRET=development-example-change-me-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
LOG_LEVEL=log
# Optional, on-demand AI explainer. Disabled keeps the deterministic app fully usable.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_TIMEOUT_MS=10000
# Opt-in seed; no default production credentials are provisioned by migrations.
DEMO_EMAIL=atif@example.test
DEMO_PASSWORD=Synthetic-Demo-Only-2026!
DEMO_MONTH=2026-09
